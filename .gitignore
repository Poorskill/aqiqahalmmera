# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
opencode.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# sqlite runtime / temp files (never commit)
*.db-shm
*.db-wal
*.db-journal
# local runtime database & uploads (keep schema, not data)
data/*.db
data/*.db-shm
data/*.db-wal
data/*.json
public/uploads/*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
